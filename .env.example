# ==============================================================================
# Configuration Lafiya - Template de variables d'environnement (.env.example)
# Aucune clef réelle ni mot de passe ne doit figurer dans ce fichier.
# ==============================================================================

# Environnement d'exécution
ENVIRONMENT=development
DEBUG=True

# Base de données MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lafiya_db

# File de tâches & Cache Redis
REDIS_URL=redis://localhost:6379/0
DEDUP_TTL_SECONDS=604800

# Base Vectorielle Qdrant
QDRANT_URL=https://<cluster-id>.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=lafiya_corpus_who

# Embeddings & Modèle de Langage (LLM)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-3-5-haiku-20241022

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Pseudonymisation & Sécurité
USER_HASH_SECRET=generate_a_random_sha256_secret_key_here

# Monitoring LangFuse
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Paramètres RAG & Rate Limiting
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.72
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# Journalisation
LOG_LEVEL=INFO
LOG_BUFFER_SIZE=50
LOG_FLUSH_INTERVAL=5
LOG_RETENTION_DAYS=30
